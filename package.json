{
  "name": "sovereignx",
  "version": "0.1.0",
  "private": true,
  "description": "SovereignX — fractionalized US T-Bills on Monad with ERC-3643 + Cleanverse compliance",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @sovereignx/web dev",
    "dev:api": "pnpm --filter @sovereignx/api dev",
    "dev:indexer": "pnpm --filter @sovereignx/indexer dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @sovereignx/shared build && pnpm --filter @sovereignx/web build",
    "test:contracts": "cd contracts && forge test",
    "deploy:testnet": "bash scripts/deploy-testnet.sh",
    "save:deployments": "node scripts/save-deployments.mjs",
    "sync:env": "node scripts/sync-env.mjs",
    "register:validator": "node scripts/register-validator-pool.mjs",
    "deposit:dividends": "node scripts/deposit-dividend-pool.mjs",
    "faucet:cva": "node scripts/request-cva-faucet.mjs",
    "generate:vercel-env": "node scripts/generate-vercel-env.mjs",
    "generate:vercel-api-env": "node scripts/generate-vercel-api-env.mjs",
    "docker:api": "docker build -f Dockerfile.api -t sovereignx-api .",
    "docker:indexer": "docker build -f Dockerfile.indexer -t sovereignx-indexer .",
    "heroku-postbuild": "pnpm --filter @sovereignx/shared build && pnpm --filter @sovereignx/api build"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.28.2"
}
