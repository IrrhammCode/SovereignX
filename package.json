{
  "name": "sovereignx",
  "version": "0.1.0",
  "private": true,
  "description": "SovereignX — fractionalized US T-Bills on Monad with ERC-3643 + Cleanverse compliance",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @sovereignx/web dev",
    "dev:api": "pnpm --filter @sovereignx/api dev",
    "dev:indexer": "pnpm --filter @sovereignx/indexer dev",
    "build": "pnpm -r build",
    "test:contracts": "cd contracts && forge test",
    "deploy:testnet": "bash scripts/deploy-testnet.sh",
    "save:deployments": "node scripts/save-deployments.mjs",
    "sync:env": "node scripts/sync-env.mjs",
    "register:validator": "node scripts/register-validator-pool.mjs",
    "deposit:dividends": "node scripts/deposit-dividend-pool.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
