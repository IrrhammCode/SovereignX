# SovereignX — Vercel environment variables (frontend only)
# Import: Vercel Dashboard → Project → Settings → Environment Variables → Import .env
# Apply to: Production, Preview, Development
#
# Before import: replace YOUR_API_URL with your deployed API base URL (Railway/Render/Fly).
# Example: https://sovereignx-api.up.railway.app  (no trailing slash)
#
# Deploy API separately — Vercel hosts only the Next.js frontend.

NEXT_PUBLIC_API_URL=https://YOUR_API_URL
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_SOVX_TOKEN_ADDRESS=0x03f6E30518347135049be7ABc901f727489E79A0
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=0x935AbfE82F9Abcc99a25f8252230d991887eB36d
NEXT_PUBLIC_COMPLIANCE_ENGINE_ADDRESS=0x622fBD1835B855334A2033ebF61Ad56f3d095286
NEXT_PUBLIC_DIVIDEND_DISTRIBUTOR_ADDRESS=0x62059f45007d65Ff127128b8Bb2f77d93aAfca11
NEXT_PUBLIC_CVA_STABLECOIN_ADDRESS=0xaC0893567D43C3E7e6e35a72803df05416C1f20D

# Clerk — get keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY
CLERK_SECRET_KEY=sk_test_YOUR_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
