# SovereignX — Vercel environment variables (frontend + optional embedded API)
# Import: Vercel Dashboard → Project → Settings → Environment Variables → Import .env
# Apply to: Production, Preview, Development
#
# FREE DEPLOY (recommended): leave NEXT_PUBLIC_API_URL unset — API runs on same Vercel
# project via pages/api (see docs/DEPLOY-FREE.md). Add API secrets below too.
#
# SPLIT DEPLOY: set NEXT_PUBLIC_API_URL to Render/Railway API URL (no trailing slash)

# NEXT_PUBLIC_API_URL=https://YOUR_API.onrender.com

# ── Embedded API secrets (FREE Vercel deploy — paste from .env, same project) ──
# CLEANVERSE_API_ID=
# CLEANVERSE_API_KEY=
# CLEANVERSE_API_URL=https://uatapi.cleanverse.com/api/cooperate
# CLEANVERSE_SKILLS_URL=https://uatapi.cleanverse.com/api/skills
# MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# MONAD_CHAIN_ID=10143
# DEPLOYER_PRIVATE_KEY=0x...
# SOVX_TOKEN_ADDRESS=0x03f6E30518347135049be7ABc901f727489E79A0
# IDENTITY_REGISTRY_ADDRESS=0x935AbfE82F9Abcc99a25f8252230d991887eB36d
# COMPLIANCE_ENGINE_ADDRESS=0x622fBD1835B855334A2033ebF61Ad56f3d095286
# DIVIDEND_DISTRIBUTOR_ADDRESS=0x62059f45007d65Ff127128b8Bb2f77d93aAfca11
# CVA_STABLECOIN_ADDRESS=0xaC0893567D43C3E7e6e35a72803df05416C1f20D
# VALIDATOR_POOL_ADDRESS=0x622fBD1835B855334A2033ebF61Ad56f3d095286

NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_SOVX_TOKEN_ADDRESS=0x03f6E30518347135049be7ABc901f727489E79A0
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=0x935AbfE82F9Abcc99a25f8252230d991887eB36d
NEXT_PUBLIC_COMPLIANCE_ENGINE_ADDRESS=0x622fBD1835B855334A2033ebF61Ad56f3d095286
NEXT_PUBLIC_DIVIDEND_DISTRIBUTOR_ADDRESS=0x62059f45007d65Ff127128b8Bb2f77d93aAfca11
NEXT_PUBLIC_CVA_STABLECOIN_ADDRESS=0xaC0893567D43C3E7e6e35a72803df05416C1f20D

# Clerk — get keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY
CLERK_SECRET_KEY=sk_test_YOUR_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
